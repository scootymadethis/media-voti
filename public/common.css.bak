@import url("https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap");

:root {
  --bg: #121212;
  --surface: #1e1e1e;
  --surface-alt: #171717;
  --primary: #ededed;
  --secondary: #a0a0a0;
  --primary-btn: #dc2626;
  --primary-hover: #a41f1f;
  --success: #22c55e;
  --warning: #facc15;
  --error: #f43f5e;
  --info: #3b82f6;
  --disabled: #5a5a5a;
  --border: #2a2a2a;
  --entry-bg: #16324a;
  --entry-text: #e6eef9;
  --shadow: 0 12px 30px rgba(0, 0, 0, 0.22);
  --container-width: min(1300px, calc(100% - 32px));
  --radius-lg: 24px;
  --radius-md: 18px;
  --radius-sm: 12px;
  --scrollbar-thumb: rgba(255, 255, 255, 0.22);
  --scrollbar-thumb-hover: rgba(255, 255, 255, 0.34);
  --scrollbar-track: transparent;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: "Inter", sans-serif;
  scrollbar-width: thin;
  scrollbar-color: var(--scrollbar-thumb) transparent;
}

*::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

*::-webkit-scrollbar-track {
  background: transparent;
}

*::-webkit-scrollbar-thumb {
  background: var(--scrollbar-thumb);
  border-radius: 999px;
}

*::-webkit-scrollbar-thumb:hover {
  background: var(--scrollbar-thumb-hover);
}

*::-webkit-scrollbar-button,
*::-webkit-scrollbar-corner {
  display: none;
  width: 0;
  height: 0;
}

html {
  color-scheme: dark;
  overflow-x: hidden;
}

body {
  background:
    radial-gradient(circle at top, rgba(220, 38, 38, 0.12), transparent 28%),
    var(--bg);
  color: var(--primary);
  min-height: 100vh;
  line-height: 1.45;
  overflow-x: hidden;
  overflow-y: auto;
}

a {
  color: inherit;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

.main {
  width: var(--container-width);
  margin: 28px auto 0;
  padding-bottom: 160px;
  min-width: 0;
}

.page-shell {
  width: var(--container-width);
  margin: 20px auto 0;
  min-width: 0;
}

.title {
  color: var(--primary-btn);
  font-weight: 900;
  letter-spacing: -0.03em;
}

.panel {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
}

.navbar {
  width: var(--container-width);
  margin: 20px auto 0;
  padding: 16px 20px;
  background: rgba(30, 30, 30, 0.96);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  box-shadow: var(--shadow);
}

.navbar .title {
  font-size: clamp(1.6rem, 3vw, 2.15rem);
}

.buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  min-width: 0;
}

.buttons button,
.btn-primary,
.login-btn {
  border: none;
  border-radius: 999px;
  padding: 0.8rem 1.15rem;
  font-weight: 700;
  background: var(--primary-btn);
  color: #fff;
  transition:
    background-color 0.2s ease,
    transform 0.2s ease,
    opacity 0.2s ease;
}

.buttons button:hover,
.btn-primary:hover,
.login-btn:hover {
  background: var(--primary-hover);
  transform: translateY(-1px);
}

.loading-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.55);
  z-index: 9998;
}

.loading-overlay.hidden {
  display: none;
}

.loading-card {
  background: var(--surface);
  color: var(--primary);
  padding: 18px 22px;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px solid var(--border);
  box-shadow: var(--shadow);
}

.loading-text {
  font-size: 16px;
}

.spinner {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 3px solid rgba(255, 255, 255, 0.08);
  border-top-color: var(--primary-btn);
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.modal {
  position: fixed;
  inset: 0;
  display: none;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.65);
  z-index: 9999;
  padding: 20px;
}

.modal.show {
  display: flex;
}

.modal-content {
  background: var(--surface);
  color: var(--primary);
  border-radius: var(--radius-md);
  padding: 18px;
  width: min(820px, 100%);
  max-height: min(85vh, 760px);
  overflow: auto;
  border: 1px solid var(--border);
  box-shadow: var(--shadow);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.modal-close {
  background: transparent;
  color: var(--primary);
  border: none;
  font-size: 1.2rem;
}

.modal-teacher {
  margin-top: 6px;
  color: var(--secondary);
  font-size: 14px;
}

.modal-label {
  margin-top: 12px;
  font-weight: 700;
  color: var(--secondary);
}

.modal-text {
  margin-top: 12px;
  white-space: pre-wrap;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.footer {
  position: fixed;
  inset-inline: 0;
  bottom: 0;
  min-height: 86px;
  background: rgba(30, 30, 30, 0.96);
  border-top: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 4px;
  padding: 12px 16px;
  text-align: center;
  z-index: 1000;
}

.footer .desc,
.footer .copyright {
  font-size: 0.9rem;
  color: var(--secondary);
}

@media (max-width: 900px) {
  .main,
  .page-shell,
  .navbar {
    width: min(100% - 24px, 1300px);
  }
}

@media (max-width: 700px) {
  .navbar {
    flex-direction: column;
    align-items: stretch;
    padding: 14px;
  }

  .buttons {
    width: 100%;
  }

  .buttons button,
  .btn-primary {
    flex: 1 1 140px;
    justify-content: center;
  }

  .main,
  .page-shell {
    margin-top: 18px;
    padding-bottom: 180px;
  }
}

@media (max-width: 480px) {
  * {
    scrollbar-width: none;
  }

  *::-webkit-scrollbar {
    width: 0;
    height: 0;
  }

  .navbar,
  .main,
  .page-shell {
    width: calc(100% - 16px);
  }

  .buttons {
    gap: 8px;
  }

  .buttons button,
  .btn-primary {
    width: auto;
    flex: 1 1 calc(33.333% - 8px);
    min-height: 42px;
    padding: 0.72rem 0.7rem;
    font-size: 0.92rem;
  }

  .modal {
    padding: 12px;
  }

  .modal-content {
    padding: 16px;
  }

  .footer {
    min-height: 104px;
    padding-bottom: calc(14px + env(safe-area-inset-bottom, 0px));
  }

  .footer .desc,
  .footer .copyright {
    font-size: 0.78rem;
  }
}
