# Dominio frontend autorizzato per le richieste al backend.
ALLOWED_ORIGINS=localhost

# Percorso del database SQLite persistente.
DATABASE_PATH=/opt/spaggiari2/data/spaggiari2.db

# Metti false solo in sviluppo locale senza HTTPS.
COOKIE_SECURE=true

# true = un solo server su :8000 serve public/ e riscrive /api/* (ideale su Windows).
DEV_MODE=false

# Username separati da virgola che vedono il pulsante easter egg (gioco Godot).
EASTER_EGG_USERNAMES=S10371217U,aaronrai829@gmail.com,S10371278X,510371115,S9456217C,S10371066B

# Admin: bootstrap senza re-password (default disabilitato in produzione).
ADMIN_ALLOW_BOOTSTRAP=false

# Rate limit login (per IP, finestra in secondi / max tentativi).
LOGIN_RATE_LIMIT_WINDOW=300
LOGIN_RATE_LIMIT_MAX=25

# Secondi di cache per /session/me: entro questa finestra non si chiama Spaggiari.
# Alza (es. 120) se Spaggiari rate-limita ancora; abbassa per dati piu' freschi.
SESSION_ME_CACHE_TTL=60
