{
  "appId": "it.federicoscutariu.spaggiari2",
  "appName": "Aulera",
  "webDir": "app-shell",
  "server": {
    "url": "https://spaggiari2.federicoscutariu.it",
    "androidScheme": "https",
    "cleartext": false,
    "errorPath": "index.html"
  },
  "android": {
    "allowMixedContent": false,
    "adjustMarginsForEdgeToEdge": "auto"
  },
  "backgroundColor": "#05070b",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#05070b",
    "scrollEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#05070b",
      "showSpinner": false
    }
  }
}
